{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.key)",
      "Read(**/keys.txt)",
      "Read(**/*.tfstate)",
      "Read(~/.config/sops/**)",
      "Read(~/.kube/**)",
      "Edit(./docs/kb/**)",
      "Write(./docs/kb/**)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(terraform destroy*)",
      "Bash(sops -d*)",
      "Bash(sops --decrypt*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Bash|WebFetch",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/guard.sh" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebFetch|Read|Bash",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/inject-scan.sh" }]
      }
    ]
  }
}
