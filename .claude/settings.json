{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/keys.txt)",
      "Read(**/*.tfstate)",
      "Read(~/.config/sops/**)",
      "Read(~/.kube/**)",
      "Read(~/.ssh/**)",
      "Edit(./docs/kb/**)",
      "Edit(./.claude/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git commit --no-verify*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(terraform destroy*)",
      "Bash(sops -d*)",
      "Bash(sops --decrypt*)",
      "Bash(sops decrypt*)",
      "Bash(sops exec-env*)",
      "Read(~/.aws/**)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(~/.docker/config.json)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.terraform.d/credentials.tfrc.json)",
      "Read(**/kubeconfig*)",
      "Read(**/.env)",
      "Edit(./repos/*/.git/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Grep|Glob|Bash|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/inject-scan.sh"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.kube",
        "~/.config/sops",
        "~/.aws",
        "~/.docker/config.json",
        "~/.git-credentials",
        "~/.netrc",
        "~/.claude/.credentials.json",
        "~/.terraform.d/credentials.tfrc.json",
        "./**/.env",
        "./**/.env.*",
        "./**/*.tfstate",
        "./**/*.tfstate.*",
        "./**/keys.txt",
        "./**/*.key",
        "./**/*.pem",
        "./**/kubeconfig*"
      ],
      "allowRead": [
        "./**/.env.example"
      ],
      "denyWrite": [
        "./.claude/**",
        "./docs/kb/**",
        "./repos/zk-auth/.git",
        "./repos/zk-detections/.git",
        "./repos/zk-platform/.git"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "registry.terraform.io",
        "releases.hashicorp.com"
      ]
    }
  }
}
