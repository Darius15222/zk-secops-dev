# each repo under repos/ is its own git repository
repos/

# secrets and keys never enter git (R-02)
.env
.env.*
!.env.example
*.key
*.pem
keys.txt
*.tfstate
*.tfstate.*
.terraform/
kubeconfig*

.claude/settings.local.json
.probe/
# output of the user's ! commands for the assistant to read
.out/
# empty mount points the Claude Code sandbox leaves in the workspace root
/.bashrc
/.bash_profile
/.profile
/.zshrc
/.zprofile
/.gitconfig
/.gitmodules
/.mcp.json
/.ripgreprc
/.idea
/.vscode
